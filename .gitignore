Documentation/2026a-milestones/**/*.dat
Documentation/2026a-milestones/**/*.pdu
Documentation/2026a-milestones/**/*.pcap

# Xcode build output (SwiftPM uses .build/; Xcode schemes emit build/)
build/

# Claude Code per-project memory (not source)
memory/

# Claude Code local-only settings and runtime state
.claude/settings.local.json
.claude/*.lock

# Python audit tooling caches
__pycache__/
